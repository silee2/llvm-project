// CHECK-LABEL:   gpu.module @test {
// CHECK:           gpu.func @load_gather_from_dyn_memref_subview(%[[VAL_0:.*]]: memref<?xf16>, %[[VAL_1:.*]]: vector<1xindex>, %[[VAL_2:.*]]: vector<1xi1>, %[[VAL_3:.*]]: memref<1xf16>) {
// CHECK:             %[[CONSTANT_0:.*]] = arith.constant 0.000000e+00 : f16
// CHECK:             %[[CONSTANT_1:.*]] = arith.constant 2 : i64
// CHECK:             %[[CONSTANT_2:.*]] = arith.constant 0 : index
// CHECK:             %[[EXTRACT_0:.*]] = vector.extract %[[VAL_2]][0] : i1 from vector<1xi1>
// CHECK:             %[[EXTRACT_1:.*]] = vector.extract %[[VAL_1]][0] : index from vector<1xindex>
// CHECK:             %[[INDEX_CASTUI_0:.*]] = arith.index_castui %[[EXTRACT_1]] : index to i64
// CHECK:             %[[SUBGROUP_ID_0:.*]] = gpu.subgroup_id : index
// CHECK:             %[[SUBVIEW_0:.*]] = memref.subview %[[VAL_0]]{{\[}}%[[SUBGROUP_ID_0]]] [16] [1] : memref<?xf16> to memref<16xf16, strided<[1], offset: ?>>
// CHECK:             %[[UNREALIZED_CONVERSION_CAST_0:.*]] = builtin.unrealized_conversion_cast %[[SUBVIEW_0]] : memref<16xf16, strided<[1], offset: ?>> to !llvm.struct<(ptr, ptr, i64, array<1 x i64>, array<1 x i64>)>
// CHECK:             %[[EXTRACTVALUE_0:.*]] = llvm.extractvalue %[[UNREALIZED_CONVERSION_CAST_0]][1] : !llvm.struct<(ptr, ptr, i64, array<1 x i64>, array<1 x i64>)>
// CHECK:             %[[EXTRACTVALUE_1:.*]] = llvm.extractvalue %[[UNREALIZED_CONVERSION_CAST_0]][2] : !llvm.struct<(ptr, ptr, i64, array<1 x i64>, array<1 x i64>)>
// CHECK:             %[[GETELEMENTPTR_0:.*]] = llvm.getelementptr %[[EXTRACTVALUE_0]]{{\[}}%[[EXTRACTVALUE_1]]] : (!llvm.ptr, i64) -> !llvm.ptr, f16
// CHECK:             %[[PTRTOINT_0:.*]] = llvm.ptrtoint %[[GETELEMENTPTR_0]] : !llvm.ptr to i64
// CHECK:             %[[MULI_0:.*]] = arith.muli %[[INDEX_CASTUI_0]], %[[CONSTANT_1]] : i64
// CHECK:             %[[ADDI_0:.*]] = arith.addi %[[PTRTOINT_0]], %[[MULI_0]] : i64
// CHECK:             %[[INTTOPTR_0:.*]] = llvm.inttoptr %[[ADDI_0]] : i64 to !llvm.ptr<1>
// CHECK:             %[[IF_0:.*]] = scf.if %[[EXTRACT_0]] -> (f16) {
// CHECK:               %[[LOAD_0:.*]] = llvm.load %[[INTTOPTR_0]] {cache_control = #xevm.load_cache_control<L1c_L2uc_L3c>} : !llvm.ptr<1> -> f16
// CHECK:               scf.yield %[[LOAD_0]] : f16
// CHECK:             } else {
// CHECK:               scf.yield %[[CONSTANT_0]] : f16
// CHECK:             }
// CHECK:             %[[BROADCAST_0:.*]] = vector.broadcast %[[IF_0]] : f16 to vector<1xf16>
// CHECK:             vector.store %[[BROADCAST_0]], %[[VAL_3]]{{\[}}%[[CONSTANT_2]]] : memref<1xf16>, vector<1xf16>
// CHECK:             gpu.return
// CHECK:           }
// CHECK:         }
gpu.module @test {
gpu.func @load_gather_from_dyn_memref_subview(%dyn: memref<?xf16>, %offset: vector<1xindex>, %mask: vector<1xi1>, %dst: memref<1xf16>) {
  %c0 = arith.constant 0 : index
  %id = gpu.subgroup_id : index
  %src = memref.subview %dyn[%id][16][1] : memref<?xf16> to memref<16xf16, strided<[1], offset: ?>>


  %0 = xegpu.load %src[%offset], %mask <{l1_hint = #xegpu.cache_hint<cached>, l2_hint = #xegpu.cache_hint<uncached>}>
      : memref<16xf16, strided<[1], offset: ?>>, vector<1xindex>, vector<1xi1> -> vector<1xf16>
  vector.store %0, %dst[%c0] : memref<1xf16>, vector<1xf16>
  gpu.return
}
}
