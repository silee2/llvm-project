// CHECK:             %[[ADDI_0:.*]] = arith.addi %[[VAL_0]], %[[MULI_0]] : i64
// CHECK:             %[[INTTOPTR_0:.*]] = llvm.inttoptr %[[ADDI_0]] : i64 to !llvm.ptr<1>
// CHECK:             %[[IF_0:.*]] = scf.if %[[EXTRACT_0]] -> (f16) {
// CHECK:               %[[LOAD_0:.*]] = llvm.load %[[INTTOPTR_0]] {cache_control = #xevm.load_cache_control<L1c_L2uc_L3c>} : !llvm.ptr<1> -> f16
// CHECK:               scf.yield %[[LOAD_0]] : f16
// CHECK:             } else {
// CHECK:               scf.yield %[[CONSTANT_1]] : f16
// CHECK:             }
// CHECK:             %[[BROADCAST_0:.*]] = vector.broadcast %[[IF_0]] : f16 to vector<1xf16>
// CHECK:             vector.store %[[BROADCAST_0]], %[[VAL_2]]{{\[}}%[[CONSTANT_0]]] : memref<1xf16>, vector<1xf16>
// CHECK:             gpu.return
// CHECK:           }
// CHECK:         }
gpu.module @test {
gpu.func @load_gather_i64_src_value_offset(%src: i64, %offset: vector<1xindex>, %dst: memref<1xf16>, %mask: vector<1xi1>) {
  %0 = xegpu.load %src[%offset], %mask <{l1_hint = #xegpu.cache_hint<cached>, l2_hint = #xegpu.cache_hint<uncached>}>
      : i64, vector<1xindex>, vector<1xi1> -> vector<1xf16>
  %c0 = arith.constant 0 : index
  vector.store %0, %dst[%c0] : memref<1xf16>, vector<1xf16>
  gpu.return
}
}

