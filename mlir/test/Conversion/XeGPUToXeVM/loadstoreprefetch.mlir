// CHECK:             %[[EXTRACT_1:.*]] = vector.extract %[[VAL_1]][0] : index from vector<1xindex>
// CHECK:             %[[INDEX_CASTUI_0:.*]] = arith.index_castui %[[EXTRACT_1]] : index to i64
