// RUN: mlir-opt -convert-xegpu-to-xevm -canonicalize %s | FileCheck %s

// CHECK-LABEL:   gpu.module @load_store_check {
// CHECK:           gpu.func @load_store(%[[VAL_0:.*]]: memref<512xf32, 1>, %[[VAL_1:.*]]: memref<256xf32, 1>) kernel {
// CHECK:             %[[CONSTANT_0:.*]] = arith.constant 512 : i64
// CHECK:             %[[CONSTANT_1:.*]] = arith.constant 384 : i64
// CHECK:             %[[MEMORY_SPACE_CAST_0:.*]] = memref.memory_space_cast %[[VAL_0]] : memref<512xf32, 1> to memref<512xf32>
// CHECK:             %[[UNREALIZED_CONVERSION_CAST_0:.*]] = builtin.unrealized_conversion_cast %[[MEMORY_SPACE_CAST_0]] : memref<512xf32> to !llvm.struct<(ptr, ptr, i64, array<1 x i64>, array<1 x i64>)>
// CHECK:             %[[MEMORY_SPACE_CAST_1:.*]] = memref.memory_space_cast %[[VAL_1]] : memref<256xf32, 1> to memref<256xf32>
// CHECK:             %[[UNREALIZED_CONVERSION_CAST_1:.*]] = builtin.unrealized_conversion_cast %[[MEMORY_SPACE_CAST_1]] : memref<256xf32> to !llvm.struct<(ptr, ptr, i64, array<1 x i64>, array<1 x i64>)>
// CHECK:             %[[EXTRACTVALUE_0:.*]] = llvm.extractvalue %[[UNREALIZED_CONVERSION_CAST_0]][1] : !llvm.struct<(ptr, ptr, i64, array<1 x i64>, array<1 x i64>)>
// CHECK:             %[[EXTRACTVALUE_1:.*]] = llvm.extractvalue %[[UNREALIZED_CONVERSION_CAST_0]][2] : !llvm.struct<(ptr, ptr, i64, array<1 x i64>, array<1 x i64>)>
// CHECK:             %[[GETELEMENTPTR_0:.*]] = llvm.getelementptr %[[EXTRACTVALUE_0]]{{\[}}%[[EXTRACTVALUE_1]]] : (!llvm.ptr, i64) -> !llvm.ptr, f32
// CHECK:             %[[PTRTOINT_0:.*]] = llvm.ptrtoint %[[GETELEMENTPTR_0]] : !llvm.ptr to i64
// CHECK:             %[[ADDI_0:.*]] = arith.addi %[[PTRTOINT_0]], %[[CONSTANT_1]] : i64
// CHECK:             %[[INTTOPTR_0:.*]] = llvm.inttoptr %[[ADDI_0]] : i64 to !llvm.ptr<1>
// CHECK:             %[[BLOCKLOAD_0:.*]] = xevm.blockload %[[INTTOPTR_0]] <{cache_control = #xevm.load_cache_control<L1c_L2uc_L3c>}> : (!llvm.ptr<1>) -> vector<2xi32>
// CHECK:             %[[EXTRACTVALUE_2:.*]] = llvm.extractvalue %[[UNREALIZED_CONVERSION_CAST_1]][1] : !llvm.struct<(ptr, ptr, i64, array<1 x i64>, array<1 x i64>)>
// CHECK:             %[[EXTRACTVALUE_3:.*]] = llvm.extractvalue %[[UNREALIZED_CONVERSION_CAST_1]][2] : !llvm.struct<(ptr, ptr, i64, array<1 x i64>, array<1 x i64>)>
// CHECK:             %[[GETELEMENTPTR_1:.*]] = llvm.getelementptr %[[EXTRACTVALUE_2]]{{\[}}%[[EXTRACTVALUE_3]]] : (!llvm.ptr, i64) -> !llvm.ptr, f32
// CHECK:             %[[PTRTOINT_1:.*]] = llvm.ptrtoint %[[GETELEMENTPTR_1]] : !llvm.ptr to i64
// CHECK:             %[[ADDI_1:.*]] = arith.addi %[[PTRTOINT_1]], %[[CONSTANT_0]] : i64
// CHECK:             %[[INTTOPTR_1:.*]] = llvm.inttoptr %[[ADDI_1]] : i64 to !llvm.ptr<1>
// CHECK:             xevm.blockstore %[[INTTOPTR_1]], %[[BLOCKLOAD_0]] <{cache_control = #xevm.store_cache_control<L1wb_L2uc_L3wb>}> : (!llvm.ptr<1>, vector<2xi32>)
// CHECK:             gpu.return
// CHECK:           }
// CHECK:         }
gpu.module @load_store_check {
    gpu.func @load_store(%src: memref<512xf32, 1>, %dst: memref<256xf32, 1>) kernel {

        %srcce = memref.memory_space_cast %src : memref<512xf32, 1> to memref<512xf32>
        %dstte = memref.memory_space_cast %dst : memref<256xf32, 1> to memref<256xf32>

        %src_tdesc = xegpu.create_nd_tdesc %srcce : memref<512xf32> -> !xegpu.tensor_desc<32xf32>
        %loaded = xegpu.load_nd %src_tdesc[96] <{l1_hint = #xegpu.cache_hint<cached>, l2_hint = #xegpu.cache_hint<uncached>}>
            : !xegpu.tensor_desc<32xf32> -> vector<2xf32>

        %dst_tdesc = xegpu.create_nd_tdesc %dstte : memref<256xf32> -> !xegpu.tensor_desc<32xf32, #xegpu.block_tdesc_attr<memory_space = global>>
        xegpu.store_nd %loaded, %dst_tdesc[128] <{l1_hint = #xegpu.cache_hint<write_back>, l2_hint = #xegpu.cache_hint<uncached>}>
            : vector<2xf32>, !xegpu.tensor_desc<32xf32, #xegpu.block_tdesc_attr<memory_space = global>>
        gpu.return
    }
}
