// CHECK:             %[[MULI_1:.*]] = arith.muli %[[CONSTANT_0]], %[[CONSTANT_3]] : index
// CHECK:             %[[ADDI_1:.*]] = arith.addi %[[MULI_1]], %[[ADDI_0]] : index
// CHECK:             %[[INDEX_CASTUI_0:.*]] = arith.index_castui %[[ADDI_1]] : index to i32
// CHECK:             %[[CONSTANT_4:.*]] = arith.constant 4 : i32
// CHECK:             %[[MULI_2:.*]] = arith.muli %[[INDEX_CASTUI_0]], %[[CONSTANT_4]] : i32
// CHECK:             %[[ADDI_2:.*]] = arith.addi %[[PTRTOINT_0]], %[[MULI_2]] : i32
// CHECK:             %[[INTTOPTR_0:.*]] = llvm.inttoptr %[[ADDI_2]] : i32 to !llvm.ptr<3>
// CHECK:             %[[LOAD_0:.*]] = llvm.load %[[INTTOPTR_0]] : !llvm.ptr<3> -> f32
// CHECK:             %[[BROADCAST_0:.*]] = vector.broadcast %[[LOAD_0]] : f32 to vector<1x1xf32>
// CHECK:             %[[SHAPE_CAST_0:.*]] = vector.shape_cast %[[BROADCAST_0]] : vector<1x1xf32> to vector<1xf32>
// CHECK:             vector.store %[[SHAPE_CAST_0]], %[[VAL_0]]{{\[}}%[[CONSTANT_0]]] : memref<128xf32>, vector<1xf32>
// CHECK:             gpu.return
// CHECK:           }
// CHECK:         }
gpu.module @materializecast [#xevm.target<chip = "pvc">]{
  gpu.func @materialize_element_to_2D_single_element_vector(%dst: memref<128xf32>) kernel {
    %c0 = arith.constant 0 : index
    %alloca_11 = memref.alloca() : memref<512xi8, 3>
    %49 = xegpu.create_mem_desc %alloca_11 : memref<512xi8, 3> -> !xegpu.mem_desc<8x16xf32>
    %50 = xegpu.load_matrix %49[%c0, %c0] : !xegpu.mem_desc<8x16xf32>, index, index -> vector<1x1xf32>
    %51 = vector.shape_cast %50 : vector<1x1xf32> to vector<1xf32>
    vector.store %51, %dst[%c0] : memref<128xf32>, vector<1xf32>
    gpu.return
  }
}

