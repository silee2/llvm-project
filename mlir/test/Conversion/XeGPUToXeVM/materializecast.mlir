// CHECK:             %[[PTRTOINT_0:.*]] = llvm.ptrtoint %[[GETELEMENTPTR_0]] : !llvm.ptr to i64
// CHECK:             %[[CONSTANT_2:.*]] = arith.constant 4 : i64
// CHECK:             %[[MULI_0:.*]] = arith.muli %[[UNREALIZED_CONVERSION_CAST_1]], %[[CONSTANT_2]] : i64
// CHECK:             %[[ADDI_0:.*]] = arith.addi %[[PTRTOINT_0]], %[[MULI_0]] : i64
