// CHECK:             %[[GETELEMENTPTR_0:.*]] = llvm.getelementptr %[[EXTRACTVALUE_0]]{{\[}}%[[EXTRACTVALUE_1]]] : (!llvm.ptr<3>, i64) -> !llvm.ptr<3>, i8
// CHECK:             %[[PTRTOINT_0:.*]] = llvm.ptrtoint %[[GETELEMENTPTR_0]] : !llvm.ptr<3> to i32
// CHECK:             %[[CONSTANT_1:.*]] = arith.constant 0 : index
