// CHECK:             %[[PTRTOINT_2:.*]] = llvm.ptrtoint %[[GETELEMENTPTR_2]] : !llvm.ptr to i64
// CHECK:             %[[INSERT_8:.*]] = vector.insert %[[PTRTOINT_2]], %[[CONSTANT_7]] [0] : i64 into vector<4xi64>
// CHECK:             %[[BITCAST_4:.*]] = vector.bitcast %[[INSERT_8]] : vector<4xi64> to vector<8xi32>
// CHECK:             %[[INSERT_9:.*]] = vector.insert %[[CONSTANT_9]], %[[BITCAST_4]] [2] : i32 into vector<8xi32>
// CHECK:             %[[INSERT_10:.*]] = vector.insert %[[CONSTANT_8]], %[[INSERT_9]] [3] : i32 into vector<8xi32>
// CHECK:             %[[INSERT_11:.*]] = vector.insert %[[CONSTANT_9]], %[[INSERT_10]] [4] : i32 into vector<8xi32>
// CHECK:             %[[BITCAST_5:.*]] = vector.bitcast %[[INSERT_11]] : vector<8xi32> to vector<4xi64>
