// CHECK:             %[[VAL_5:.*]] = xevm.blockload2d %[[INTTOPTR_2]], %[[CONSTANT_8]], %[[CONSTANT_8]], %[[CONSTANT_8]], %[[CONSTANT_5]], %[[CONSTANT_6]] <{cache_control = #xevm.load_cache_control<L1c_L2uc_L3c>, elem_size_in_bits = 8 : i32, pack_register = true, tile_height = 32 : i32, tile_width = 16 : i32, transpose = false, v_blocks = 1 : i32}> : (!llvm.ptr<1>, i32, i32, i32, i32, i32) -> vector<8xi32>
// CHECK:             %[[BITCAST_6:.*]] = vector.bitcast %[[VAL_5]] : vector<8xi32> to vector<64xi4>
// CHECK:             vector.store %[[BITCAST_6]], %[[MEMORY_SPACE_CAST_3]]{{\[}}%[[CONSTANT_11]], %[[CONSTANT_10]]] : memref<64x128xi4>, vector<64xi4>
